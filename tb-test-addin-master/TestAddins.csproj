<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <AssemblyName>Toolbox.Addin.TestAddins</AssemblyName>
    <AssemblyTitle>TestAddins</AssemblyTitle>
    <Description>OECD Toolbox addin for TEST models</Description>
    <Company>US EPA</Company>
    <Product>TEST TB Addin</Product>
    <AssemblyVersion>1.2.3.1</AssemblyVersion>
    <FileVersion>1.2.3.1</FileVersion>
    <Version>1.2.3.1</Version>
    <Authors>Todd Martin</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <OutputPath>..\PackageStaging\ToolboxServerAddinsFolder\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>..\PackageStaging\ToolboxServerAddinsFolder\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Toolbox.Docking.Api, Version=4.9.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>C:\Program Files\QSAR Toolbox\QSAR Toolbox 4.9\Toolbox Server\Bin\Toolbox.Docking.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\testmodels.txt">
      <LogicalName>Toolbox.Addin.TestAddins.Resources.testmodels.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Qsar\SetRetriever.cs" />
    <Compile Remove="FactorySmokeTest\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="**\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>